# ==============================================================================
# nim-hnvs Production Docker Environment Configuration
# Copy this file to .env before running docker compose:
#   cp .env.docker.example .env
# ==============================================================================

# Web Server Host Binding & Port
BIND_IP=100.64.0.2
PORT=5055

# Administrator Credentials
ADMIN_USERNAME=nimalakasiotis
ADMIN_PASSWORD=your_secure_admin_password_here

# Google Gemini API Key for OCR Vision (extracting topics from lecture notes)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Open eClass API integration
ECLASS_API_KEY=
